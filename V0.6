    if checkwin(0, 1, sym) or checkwin(1, 0, sym) or checkwin(1, 1, sym) or checkwin(-1, 1, sym):
        #printboard()
        winners.append(n)
        #print("END", sym)
        gameover=True
    end=1
    for i in range(6):
        for j in range(7):
            if board[i][j]==0:
                end=0
    if end==1:
        gameover=True
