def createinput(n):
    global num, numofnn, inputlayer
    for k in range(numofnn):
        for i in range(n):
            mylist=[i]
            inputlayer.append(mylist)
        for j in range(n):
            for i in range(len(hiddenlayerslist[k])+1):
                inputlayer[j].append(random.randint(-num, num)/num)
        inputlayerlist.append(inputlayer)
        inputlayer=[]

